# Copier ce fichier en .env avant de lancer `docker compose up` et l'API.
# Ces valeurs sont volontairement simples : environnement de développement uniquement.

NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
POSTGRES_DB=ecoda
POSTGRES_USER=ecoda_user
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecoda_user:changeme_dev_only@localhost:5432/ecoda

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Clé identique entre la génération (POST /login, fournie) et la vérification
# (middleware à coder). Ne jamais faire tourner ce genre de secret en clair
# en dehors d'un environnement de développement.
JWT_SECRET=907619cc86944766dc606b0c0bd05b550827c32d63a5d3339a4511c9a29b062e
JWT_EXPIRES_IN=1h
