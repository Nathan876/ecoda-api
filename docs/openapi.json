{
  "openapi": "3.0.0",
  "info": {
    "title": "Ecoda API",
    "version": "0.1.0",
    "description": "API publique de la plateforme Ecoda (utilisateurs, objectifs, défis, actions, badges). Cette documentation est générée automatiquement à partir des schémas Zod déclarés dans src/schemas/ et enregistrés via registry.registerPath(...) dans chaque fichier de route (src/routes/*.ts) : le même schéma sert à la fois à valider les requêtes et à documenter l'API, sans YAML à écrire à la main."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok"
          },
          "dependencies": {
            "$ref": "#/components/schemas/HealthDependencies"
          }
        },
        "required": [
          "status",
          "dependencies"
        ]
      },
      "HealthDependencies": {
        "type": "object",
        "properties": {
          "postgres": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          }
        },
        "required": [
          "postgres",
          "redis"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "token"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "lea.martin@ecoda.io"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "EcodaDemo123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "example": "lea.martin@ecoda.io"
          },
          "firstName": {
            "type": "string",
            "example": "Léa"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-01-15T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "createdAt"
        ]
      },
      "ValidateActionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 12
          },
          "challengeId": {
            "type": "integer",
            "example": 3
          },
          "actionDate": {
            "type": "string",
            "example": "2026-10-16"
          },
          "status": {
            "type": "string",
            "enum": [
              "validated"
            ]
          },
          "pointsEarned": {
            "type": "integer",
            "example": 20
          }
        },
        "required": [
          "id",
          "challengeId",
          "actionDate",
          "status",
          "pointsEarned"
        ]
      },
      "ValidateActionRequest": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "example": 3
          }
        },
        "required": [
          "challengeId"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Vérifie que l'API et ses dépendances (PostgreSQL, Redis) répondent",
        "tags": [
          "Système"
        ],
        "responses": {
          "200": {
            "description": "L'API et ses dépendances sont opérationnelles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Au moins une dépendance (PostgreSQL ou Redis) est indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authentifie un utilisateur et génère un token JWT",
        "tags": [
          "Authentification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentification réussie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (email ou mot de passe manquant/invalide)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Révoque le token courant (blacklist Redis)",
        "description": "Ajoute le token à une blacklist Redis jusqu'à son expiration naturelle (claim exp). Toute requête ultérieure avec ce token renvoie 401 Token has been revoked.",
        "tags": [
          "Authentification"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Déconnexion réussie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Token absent, invalide, expiré ou déjà révoqué",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "summary": "Obtenir ses informations en tant qu'utilisateur",
        "tags": [
          "Utilisateurs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Données récupérées",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Token absent non valide ou révoqué",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Utilisateur introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/actions": {
      "post": {
        "summary": "Valider un défi pour aujourd'hui",
        "description": "Valide le défi indiqué pour l'utilisateur connecté (identifié par son token). Limité à 10 requêtes par minute et par utilisateur (Redis).",
        "tags": [
          "Actions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateActionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Défi validé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateActionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Payload invalide (challengeId doit être un entier positif)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent, invalide, expiré ou révoqué",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Défi introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Défi déjà validé aujourd'hui",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Trop de requêtes (10 par minute et par utilisateur)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}